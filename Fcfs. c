/*
------------------------------------------------------------
Program: First Come First Serve (FCFS) Scheduling Algorithm
Description:
    This program calculates:
    - Waiting Time (WT)
    - Turnaround Time (TAT)
    - Average Waiting Time
    - Average Turnaround Time

Algorithm:
    Processes are executed in the order of arrival time.
------------------------------------------------------------
*/

#include <stdio.h>

int main() {
    int n;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    if (n <= 0 || n > 100) {
        printf("Invalid number of processes\n");
        return 0;
    }

    int pid[100], at[100], bt[100];
    int wt[100], tat[100];
    int original_index[100];

    printf("\nEnter Process ID, Arrival Time and Burst Time:\n");

    for (int i = 0; i < n; i++) {
        scanf("%d %d %d", &pid[i], &at[i], &bt[i]);
        original_index[i] = i;  // Store original position
    }

    // Sorting by Arrival Time (FCFS rule)
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {

            if (at[j] > at[j + 1] ||
               (at[j] == at[j + 1] && pid[j] > pid[j + 1])) {

                int temp;

                // Swap arrival time
                temp = at[j];
                at[j] = at[j + 1];
                at[j + 1] = temp;

                // Swap burst time
                temp = bt[j];
                bt[j] = bt[j + 1];
                bt[j + 1] = temp;

                // Swap process id
                temp = pid[j];
                pid[j] = pid[j + 1];
                pid[j + 1] = temp;

                // Swap original index
                temp = original_index[j];
                original_index[j] = original_index[j + 1];
                original_index[j + 1] = temp;
            }
        }
    }

    int current_time = 0;

    // Calculate Waiting Time and Turnaround Time
    for (int i = 0; i < n; i++) {

        if (current_time < at[i])
            current_time = at[i];

        wt[i] = current_time - at[i];
        tat[i] = wt[i] + bt[i];

        current_time += bt[i];
    }

    // Reordering results to original input order
    int final_wt[100], final_tat[100];

    for (int i = 0; i < n; i++) {
        final_wt[original_index[i]] = wt[i];
        final_tat[original_index[i]] = tat[i];
    }

    double avgWT = 0, avgTAT = 0;

    for (int i = 0; i < n; i++) {
        avgWT += final_wt[i];
        avgTAT += final_tat[i];
    }

    avgWT /= n;
    avgTAT /= n;

    printf("\nWaiting Time:\n");
    for (int i = 0; i < n; i++)
        printf("P%d : %d\n", pid[i], final_wt[i]);

    printf("\nTurnaround Time:\n");
    for (int i = 0; i < n; i++)
        printf("P%d : %d\n", pid[i], final_tat[i]);

    printf("\nAverage Waiting Time: %.2f\n", avgWT);
    printf("Average Turnaround Time: %.2f\n", avgTAT);

    return 0;
}
